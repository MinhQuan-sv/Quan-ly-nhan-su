#db.url=jdbc:mysql://localhost:3306/QuanLyNhanSu?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh&allowMultiQueries=true&useSSL=false&allowPublicKeyRetrieval=true
